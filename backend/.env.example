# --- Database ---
# Postgres connection string for Prisma. Use your own Postgres (local,
# Docker, Supabase's own Postgres, Neon, etc). This is independent from
# AFTERSHOW's and ANTEIKU's databases — the hub owns its own data.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/world_connector?schema=public"

# --- Server ---
PORT=4000
# Comma-separated list of origins allowed to call this API
CORS_ORIGIN="http://localhost:5173"

# --- Supabase (Auth + Storage) ---
# Project URL, e.g. https://xxxxx.supabase.co
SUPABASE_URL=""
# Service role key — server-side only, NEVER expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=""
# Storage bucket used for website artwork uploads
SUPABASE_ARTWORK_BUCKET="world-artwork"

# --- Admin access control ---
# Comma-separated list of Supabase Auth email addresses allowed to use
# the admin API. A verified Supabase JWT alone is not enough — the email
# must also appear here.
ADMIN_EMAILS="owner@example.com"
